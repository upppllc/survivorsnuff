{
  "extends": "$app/tsconfig",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "sourceMap": true,
    "strict": false,
    "resolveJsonModule": true
  },
  "include": [
    "src/**/*.js",
    "src/**/*.svelte",
    "tests/**/*.mjs"
  ],
  "exclude": [
    "node_modules",
    ".vercel"
  ]
}
